# ghostty-next pinned toolchain. Every published GhosttyNextKit records these
# values in its manifest. Change them only in a reviewed commit.
ZIG_VERSION=0.17.0
ZIG_AARCH64_MACOS_SHA256=b607e9b9234790a008116ae5bdb71c6243b84b9fb42a53a9e70fde41c06c536a
# install-zig.sh applies Zig master's 0bfd34342b ("std.Io.Threaded: only use
# spawnDarwin in processReplace when spawning is supported", 2026-10-03, not
# in 0.17.0) to lib/std/Io/Threaded.zig: without it no iOS slice compiles
# (processReplace reaches getDevNullFd, and iOS's NullFile has no fd). The
# file's sha256 before and after the one-line change:
ZIG_STD_THREADED_SHA256=1a770001e309f24c8c58a9fdb3c095994c454cbfa9dba9d4f1dede2f134eeac7
ZIG_STD_THREADED_PATCHED_SHA256=1d7bdb0d31fb82dc47c3b5568691db2ef2f7c8313b6a02a311644f212acb412f
XCODE_APP=/Applications/Xcode_26.6.app
# Build flavor: bump when build flags change without a source change.
GHOSTTYKIT_FLAVOR=apple-v6
